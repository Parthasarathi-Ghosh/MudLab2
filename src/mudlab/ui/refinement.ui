           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="lblGoF">
            <property name="toolTip">
             <string>Goodness of fit of the best solution, averaged over the mixture's specimens.</string>
            </property>
            <property name="text">
             <string>GoF (best solution)</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QLabel" name="lbl_gof">
            <property name="text">
             <string>-</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="Line" name="resultSeparator">
          <property name="orientation">
