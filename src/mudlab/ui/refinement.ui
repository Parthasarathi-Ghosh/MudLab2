          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="lblBest">
            <property name="text">
             <string>Best residual (Rp)</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QLabel" name="lbl_best_residual">
            <property name="text">
