        <string>3. Result</string>
       </property>
       <layout class="QVBoxLayout" name="resultLayout">
        <item>
         <layout class="QFormLayout" name="residualForm">
          <item row="0" column="0">
           <widget class="QLabel" name="lblInitial">
            <property name="text">
             <string>Initial residual (Rp)</string>
