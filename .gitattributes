# Deterministic line endings (encoding is UTF-8 everywhere, see .editorconfig)
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# .mud / .cmp / .phs files are ZIP archives - keep them binary so text/eol
# normalization can never corrupt them. (.cmp/.phs are used by the bundled
# default-component catalog under src/mudlab/data, which DOES ship.)
*.mud binary
*.cmp binary
*.phs binary

# Test-only sample projects: the .mud fixtures are gitignored (untracked), so
# they are never committed or pushed to origin. This export-ignore is
# defense-in-depth - it keeps tools/sample_projects/ out of `git archive`
# output (GitHub release source archives) even if a fixture is ever
# force-added. The PyInstaller build also excludes them (MudLab.spec datas=[],
# no app code imports them).
tools/sample_projects/** export-ignore
