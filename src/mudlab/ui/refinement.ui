          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="lblKeepWhich">
          <property name="text">
           <string>Which solution do you want to keep?</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QVBoxLayout" name="applyLayout">
          <item>
