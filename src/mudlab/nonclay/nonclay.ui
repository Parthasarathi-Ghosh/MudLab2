<ui version="4.0">
 <class>NonclayDialog</class>
 <widget class="QDialog" name="NonclayDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>640</width>
    <height>520</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Non-clay decomposition</string>
  </property>
  <layout class="QVBoxLayout" name="rootLayout">
   <item>
    <widget class="QLabel" name="lbl_title">
     <property name="text">
      <string>Fit non-clay reference patterns to the clay-subtracted residual (EXPERIMENTAL). The XRD share is semi-quantitative (orientation-biased); add XRF oxides for a weight %.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="topRow">
     <item>
      <widget class="QGroupBox" name="grp_refs">
       <property name="title">
        <string>Non-clay reference patterns</string>
       </property>
       <layout class="QHBoxLayout" name="refsLayout">
        <item>
         <widget class="QListWidget" name="list_refs"/>
        </item>
        <item>
         <layout class="QVBoxLayout" name="refsButtons">
          <item>
           <widget class="QPushButton" name="btn_add_ref">
            <property name="toolTip">
             <string>Add a measured non-clay reference curve (e.g. quartz).</string>
            </property>
            <property name="text">
             <string>Add measured&#8230;</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btn_add_cif">
            <property name="toolTip">
             <string>Build a reference from a crystal structure (CIF with explicit symmetry ops, e.g. from COD/AMCSD), using this specimen's goniometer.</string>
            </property>
            <property name="text">
             <string>Add from CIF&#8230;</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btn_edit_comp">
            <property name="toolTip">
             <string>Set the oxide composition (wt %) of the selected reference by hand, for the XRF mass balance.</string>
            </property>
            <property name="text">
             <string>Composition&#8230;</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btn_remove_ref">
            <property name="text">
             <string>Remove</string>
            </property>
           </widget>
          </item>
          <item>
           <spacer name="refsButtonSpacer">
            <property name="orientation">
             <enum>Qt::Vertical</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>20</width>
              <height>20</height>
             </size>
            </property>
           </spacer>
          </item>
          <item>
           <widget class="QPushButton" name="btn_run">
            <property name="toolTip">
             <string>Decompose every specimen against the loaded references.</string>
            </property>
            <property name="text">
             <string>Run</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="grp_xrf">
       <property name="maximumSize">
        <size>
         <width>190</width>
         <height>16777215</height>
        </size>
       </property>
       <property name="title">
        <string>XRF oxides (wt %, optional)</string>
       </property>
       <layout class="QVBoxLayout" name="xrfLayout">
        <item>
         <widget class="QTableWidget" name="tbl_xrf"/>
        </item>
        <item>
         <widget class="QLabel" name="lbl_xrf_hint">
          <property name="text">
