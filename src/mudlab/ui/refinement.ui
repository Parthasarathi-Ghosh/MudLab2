         <verstretch>0</verstretch>
        </sizepolicy>
       </property>
       <property name="title">
        <string>1. Parameters to refine</string>
       </property>
       <layout class="QVBoxLayout" name="parametersLayout">
        <item>
         <widget class="QLabel" name="lblRefinables">
          <property name="text">
           <string>Tick &quot;Refine&quot; and set Min/Max for the parameters to refine:</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QTableWidget" name="tbl_refinables">
          <property name="minimumSize">
           <size>
            <width>390</width>
            <height>0</height>
           </size>
          </property>
          <property name="alternatingRowColors">
           <bool>true</bool>
          </property>
          <property name="selectionMode">
           <enum>QAbstractItemView::NoSelection</enum>
          </property>
          <property name="textElideMode">
           <enum>Qt::ElideRight</enum>
          </property>
          <property name="wordWrap">
           <bool>false</bool>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="paramButtonRow">
          <item>
           <widget class="QPushButton" name="btn_auto_restrict">
            <property name="toolTip">
             <string>Set Min/Max to +/-20% of each flagged parameter's current value.</string>
            </property>
            <property name="text">
             <string>Auto-restrict</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btn_randomize">
            <property name="toolTip">
             <string>Randomize each flagged parameter within its Min/Max.</string>
            </property>
            <property name="text">
             <string>Randomize</string>
            </property>
           </widget>
          </item>
          <item>
           <spacer name="paramButtonSpacer">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>0</width>
              <height>20</height>
             </size>
            </property>
           </spacer>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="grpRefine">
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
         <horstretch>4</horstretch>
         <verstretch>0</verstretch>
        </sizepolicy>
       </property>
       <property name="title">
        <string>2. Refinement</string>
       </property>
       <layout class="QVBoxLayout" name="refineFrameLayout">
        <item>
         <layout class="QHBoxLayout" name="methodRow">
          <item>
           <widget class="QLabel" name="lblMethod">
            <property name="text">
             <string>Method</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QComboBox" name="cmb_method">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
              <horstretch>1</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btn_refine">
            <property name="toolTip">
             <string>Run the refinement on a background thread; Cancel keeps the best result so far.</string>
            </property>
            <property name="text">
             <string>Refine</string>
            </property>
            <property name="default">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btn_cancel">
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="toolTip">
             <string>Stop the running refinement and keep the best solution found so far.</string>
            </property>
            <property name="text">
             <string>Cancel</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <layout class="QVBoxLayout" name="optionsLayout"/>
        </item>
